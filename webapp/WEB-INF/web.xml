<?xml version="1.0" encoding="UTF-8"?>
<!-- web.xml: connects each URL (like /items) to a servlet class -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Jewellery Management System</display-name>

    <!-- LoginServlet starts first and loads the data files -->
    <!-- Number format (1,250,000): used even when the browser sends no language -->
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.fallbackLocale</param-name>
        <param-value>en_US</param-value>
    </context-param>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.LoginServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- ItemServlet also receives the picture file chosen in the item form (multipart). Max picture size: 3 MB -->
    <servlet>
        <servlet-name>ItemServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.ItemServlet</servlet-class>
        <multipart-config>
            <max-file-size>3145728</max-file-size>
            <max-request-size>4194304</max-request-size>
            <file-size-threshold>524288</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>ItemServlet</servlet-name>
        <url-pattern>/items</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CollectionServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.CollectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CollectionServlet</servlet-name>
        <url-pattern>/collection</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CustomerServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.CustomerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerServlet</servlet-name>
        <url-pattern>/customers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SaleServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.SaleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SaleServlet</servlet-name>
        <url-pattern>/sales</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RateServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.RateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RateServlet</servlet-name>
        <url-pattern>/rates</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BestSellerServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.BestSellerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BestSellerServlet</servlet-name>
        <url-pattern>/bestsellers</url-pattern>
    </servlet-mapping>

    <!-- CartServlet: the shopping cart (add, change quantity, remove, checkout) -->
    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.CartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>

    <!-- OrderServlet: custom orders and repairs (order tracking) -->
    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.OrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/orders</url-pattern>
    </servlet-mapping>

    <!-- CalculatorServlet: price calculator (weight x gold rate + making charges ...) -->
    <servlet>
        <servlet-name>CalculatorServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.CalculatorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CalculatorServlet</servlet-name>
        <url-pattern>/calculator</url-pattern>
    </servlet-mapping>

    <!-- UploadServlet shows pictures uploaded by the admin (saved in data/uploads) -->
    <servlet>
        <servlet-name>UploadServlet</servlet-name>
        <servlet-class>com.jewellery.servlet.UploadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UploadServlet</servlet-name>
        <url-pattern>/uploads/*</url-pattern>
    </servlet-mapping>

    <!-- Exception handling: if a data file cannot be read or written (or any other error happens),
         the user sees the friendly error.jsp page instead of a raw Java error -->
    <error-page>
        <exception-type>com.jewellery.storage.DataFileException</exception-type>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Opening http://localhost:8080/ shows the login page -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
</web-app>
